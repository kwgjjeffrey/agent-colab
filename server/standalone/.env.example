COLAB_SERVER_ADDRESS=127.0.0.1:8787
COLAB_DATABASE_URL=postgresql://localhost/agent_colab_dev
COLAB_DATABASE_MAX_CONNECTIONS=10
COLAB_GOOGLE_OAUTH_CREDENTIALS_FILE=/absolute/path/to/client_secret.json
COLAB_PUBLIC_URL=http://127.0.0.1:8787
COLAB_BLOB_ROOT=.data/blobs
# Any standards-compliant SMTP server. Examples: Mailpit in development,
# a self-hosted Postfix/Postal instance, or a hosted transactional mail service.
COLAB_SMTP_URL=smtps://username:password@smtp.example.com:465
COLAB_EMAIL_FROM=Colab <invite@agent-colab.zhiyuanwangluo.online>
# Cloudflare REST adapter. On Workers Free it can send only to verified
# destination addresses; that is enough for the initial end-to-end validation.
COLAB_CLOUDFLARE_EMAIL_ACCOUNT_ID=
COLAB_CLOUDFLARE_EMAIL_API_TOKEN=
