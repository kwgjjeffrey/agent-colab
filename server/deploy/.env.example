# Copy to .env.local. Never commit the real deployment target or credentials.
DEPLOY_SSH_HOST=server.example.com
DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=22

# Remote paths and service identity.
DEPLOY_APP_ROOT=/opt/agent-colab
DEPLOY_SERVICE_NAME=agent-colab-server
DEPLOY_HEALTH_URL=http://127.0.0.1:8787/health/ready

# Mail host used by the self-hosted SMTP service. DNS and PTR must agree.
DEPLOY_MAIL_HOST=mail.agent-colab.example.com
