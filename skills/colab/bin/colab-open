#!/usr/bin/env python3
"""Start Colab Local Core when needed and open its authenticated GUI."""
from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.parse

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from lib.platform_paths import application_root

ROOT = application_root()
DISCOVERY = pathlib.Path(os.environ.get("COLAB_DISCOVERY_FILE", ROOT / "discovery.json"))


def start_local_core():
    if sys.platform == "darwin":
        subprocess.run(
            ["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/online.agent-colab.core"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    elif sys.platform == "win32":
        subprocess.run(
            ["schtasks", "/Run", "/TN", "AgentColabCore"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def main() -> int:
    start_local_core()
    for _ in range(50):
        try:
            discovered = json.loads(DISCOVERY.read_text())
            endpoint = discovered["endpoint"].rstrip("/")
            bearer = discovered["bearer"]
            break
        except (OSError, KeyError, ValueError):
            time.sleep(0.1)
    else:
        print(json.dumps({"ok": False, "error": {"code": "core_unavailable", "message": f"Local Core did not publish {DISCOVERY}"}}))
        return 3
    url = endpoint + "/bootstrap?" + urllib.parse.urlencode({"token": bearer})
    if sys.platform == "win32":
        os.startfile(url)  # type: ignore[attr-defined]
    else:
        command = ["open", url] if sys.platform == "darwin" else ["xdg-open", url]
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(json.dumps({"ok": True, "data": {"opened": True}}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
