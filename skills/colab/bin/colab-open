#!/usr/bin/env python3
"""Start Colab Local Core when needed and open its authenticated GUI."""
from __future__ import annotations

import json
import argparse
import os
import pathlib
import subprocess
import sys
import time
import urllib.parse

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
from lib.platform_paths import application_root
from output import success, failure
from local_api import request, LocalApiError

ROOT = application_root()
DISCOVERY = pathlib.Path(os.environ.get("COLAB_DISCOVERY_FILE", ROOT / "discovery.json"))


def start_local_core():
    try:
        request("GET", "/v1/status", timeout=2)
        return
    except (LocalApiError, TimeoutError):
        pass
    if sys.platform == "darwin":
        subprocess.run(
            ["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/online.agent-colab.core"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    elif sys.platform == "win32":
        subprocess.run(
            ["schtasks", "/Run", "/TN", "AgentColabCore"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--invitation", help="Channel invitation token; opens its Session share picker")
    parser.add_argument("--channel", help="Open an already joined Channel")
    args = parser.parse_args()
    start_local_core()
    for _ in range(50):
        try:
            discovered = json.loads(DISCOVERY.read_text())
            endpoint = discovered["endpoint"].rstrip("/")
            bearer = discovered["bearer"]
            break
        except (OSError, KeyError, ValueError):
            time.sleep(0.1)
    else:
        return failure("core_unavailable", "Local Core is unavailable. Run colab-setup to repair the installation, then retry.", 3)
    parameters = {"token": bearer}
    if args.invitation:
        parameters["join"] = args.invitation
    if args.channel:
        # A fragment survives bootstrap redirects without changing the Core contract.
        fragment = "#channel=" + urllib.parse.quote(args.channel, safe="")
    else:
        fragment = ""
    url = endpoint + "/bootstrap?" + urllib.parse.urlencode(parameters) + fragment
    if sys.platform == "win32":
        os.startfile(url)  # type: ignore[attr-defined]
    else:
        command = ["open", url] if sys.platform == "darwin" else ["xdg-open", url]
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return success({"opened": True})


if __name__ == "__main__":
    raise SystemExit(__import__("telemetry").run(main))
