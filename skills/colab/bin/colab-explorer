#!/usr/bin/env python3
"""Explore mixed Channel catalogs through Local Core."""
import argparse
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from local_api import DEFAULT_CORE, LocalApiError
from output import success, failure
from explorer import open_ref, create_catalog, mutate_catalog, move, share


def main():
    parser = argparse.ArgumentParser(prog="colab-explorer")
    parser.add_argument("--core", default=DEFAULT_CORE)
    commands = parser.add_subparsers(dest="operation", required=True)
    opening = commands.add_parser("open", help="List direct children or inspect one asset")
    opening.add_argument("--ref", required=True)
    opening.add_argument("--offset", type=int, default=0)
    opening.add_argument("--limit", type=int, default=100)
    create = commands.add_parser("create-catalog")
    create.add_argument("--parent", required=True)
    create.add_argument("--name", required=True)
    rename = commands.add_parser("rename-catalog")
    rename.add_argument("--ref", required=True)
    rename.add_argument("--name", required=True)
    remove = commands.add_parser("remove-catalog", help="Remove an empty Catalog only")
    remove.add_argument("--ref", required=True)
    moving = commands.add_parser("move")
    moving.add_argument("--ref", required=True)
    moving.add_argument("--parent", required=True)
    sharing = commands.add_parser("share", help="Register a source into a Channel or Catalog")
    sharing.add_argument("--parent", required=True)
    sharing.add_argument("--item-type", required=True, choices=["files","session","skill"])
    sharing.add_argument("--source", required=True)
    sharing.add_argument("--name")
    sharing.add_argument("--exclude", action="append", default=[], help="Files-only supported directory name from inspect-source candidates; repeat as needed")
    args = parser.parse_args()
    __import__("telemetry").select_operation(args)
    try:
        if args.operation == "create-catalog": return success(create_catalog(args.core, args.parent, args.name))
        if args.operation == "rename-catalog": return success(mutate_catalog(args.core, args.ref, args.name))
        if args.operation == "remove-catalog": return success(mutate_catalog(args.core, args.ref, remove=True))
        if args.operation == "move": return success(move(args.core, args.ref, args.parent))
        if args.operation == "share": return success(share(args.core, args.parent, args.item_type, args.source, args.name, args.exclude))
        if args.offset < 0 or not 1 <= args.limit <= 199:
            raise ValueError("offset must be nonnegative; limit must be 1–199")
        result = open_ref(args.core, args.ref, args.offset, args.limit)
        next_offset = result.pop("nextOffset", None)
        return success(result, page={"nextOffset": next_offset} if next_offset is not None else None)
    except ValueError as error:
        return failure("invalid_argument", str(error), 2)
    except LocalApiError as error:
        return failure("local_api_error", str(error), error.exit_code)


if __name__ == "__main__":
    raise SystemExit(__import__("telemetry").run(main))
