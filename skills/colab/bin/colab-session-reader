#!/usr/bin/env python3
"""Read a shared Session through Local Core's provider adapters."""
from __future__ import annotations
import argparse, sys
from pathlib import Path
from urllib.parse import unquote, urlparse

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from local_api import DEFAULT_CORE, LocalApiError, request
from output import failure, success

def parse_ref(value: str):
    parsed = urlparse(value)
    parts = ([parsed.netloc] if parsed.netloc else []) + [unquote(p) for p in parsed.path.split("/") if p]
    if parsed.scheme != "colab" or len(parts) != 3 or parts[0] != "channel":
        raise ValueError("ref must be colab://channel/{channel-name}/{session-name}")
    return parts[1], parts[2]

def matches(rows, value):
    exact = [row for row in rows if row["id"] == value]
    return exact or [row for row in rows if row["name"].casefold() == value.casefold()]

def resolve(core, ref):
    channel_name, session_name = parse_ref(ref)
    candidates = []
    for channel in matches(request("GET", "/v1/channels", core=core), channel_name):
        for session in matches(request("GET", f"/v1/channels/{channel['id']}/sessions", core=core), session_name):
            candidates.append((channel, session))
    if not candidates:
        raise LocalApiError(f"Shared Session not found: {session_name}")
    if len(candidates) != 1:
        detail = [{"channel": c["name"], "session": s["name"], "contributor": s.get("contributorName"), "updatedAt": s.get("updatedAt"), "preciseRef": f"colab://channel/{c['id']}/{s['id']}"} for c, s in candidates]
        raise LocalApiError(f"Session reference is ambiguous: {detail}", 2)
    return candidates[0][1]

def main():
    parser = argparse.ArgumentParser(prog="colab-session-reader")
    parser.add_argument("--core", default=DEFAULT_CORE)
    commands = parser.add_subparsers(dest="operation", required=True)
    read = commands.add_parser("read")
    read.add_argument("--ref", required=True)
    read.add_argument("--cursor")
    read.add_argument("--turn-limit", type=int, default=20)
    read.add_argument("--include-outputs", action="store_true")
    read.add_argument("--max-output-chars-per-item", type=int, default=4000)
    args = parser.parse_args()
    success = __import__("output_views").writer("session-reader", args)
    try:
        session = resolve(args.core, args.ref)
        # First use may materialize a very large historical Session. Local Core streams it to
        # disk; keep the loopback wait above ordinary CRUD timeouts instead of aborting a valid
        # transfer just before its atomic activation. Subsequent cached reads are fast.
        value = request("POST", f"/v1/sessions/{session['id']}/read", core=args.core, timeout=900, body={"cursor": args.cursor, "turnLimit": args.turn_limit, "includeOutputs": args.include_outputs, "maxOutputCharsPerItem": args.max_output_chars_per_item})
        return success(value)
    except ValueError as error:
        return failure("invalid_argument", str(error), 2)
    except LocalApiError as error:
        return failure("local_api_error", str(error), error.exit_code)

if __name__ == "__main__":
    raise SystemExit(__import__("telemetry").run(main))
