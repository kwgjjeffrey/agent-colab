# Copy to packaging/.env.local. The real file is ignored by Git.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=agent-colab
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://artifacts.example.com

# Optional. Defaults to ~/.config/agent-colab/release-signing-key.
# COLAB_RELEASE_SIGNING_KEY=/absolute/path/to/release-signing-key
# Official desktop builds embed their Google installed-app OAuth client configuration.
# Open-source forks provide their own ignored local path; end users are never prompted for it.
COLAB_DESKTOP_GOOGLE_OAUTH_CREDENTIALS_FILE=/absolute/path/to/google-desktop-oauth-client.json
